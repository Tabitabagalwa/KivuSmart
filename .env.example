# Copy to .env and adapt. Never commit the real .env.

# development | test | production
KIVU_ENVIRONMENT=development

# PostgreSQL/PostGIS (see docker-compose.yml)
KIVU_DATABASE_URL=postgresql+psycopg://kivu:kivu@localhost:5432/kivu_smart
KIVU_AUTO_CREATE_TABLES=false

# Required for write endpoints in production (>= 24 random characters), sent as X-API-Key.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
KIVU_API_KEY=

# JSON lists
KIVU_CORS_ORIGINS=["http://localhost:8501"]
KIVU_ALLOWED_HOSTS=["*"]
KIVU_RATE_LIMIT_PER_MINUTE=120
KIVU_MAX_UPLOAD_MB=50
KIVU_DOCS_ENABLED=true

# NASA Earthdata Login (https://urs.earthdata.nasa.gov)
# Token: granule downloads (CMR links). Username/password: AppEEARS.
KIVU_EARTHDATA_TOKEN=
KIVU_EARTHDATA_USERNAME=
KIVU_EARTHDATA_PASSWORD=
KIVU_NASA_TIMEOUT_S=60
KIVU_NASA_MAX_RETRIES=3
KIVU_NASA_CACHE_TTL_HOURS=24
